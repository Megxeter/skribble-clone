{
  "name": "skribbl-clone",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build:shared && npm run build:client && npm run build:server",
    "build:shared": "npm run build --workspace=shared",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:frontend": "npm run build:shared && npm run build:client",
    "build:backend": "npm run build:shared && npm run build:server",
    "start": "node server/dist/server.js",
    "test:m1": "node scripts/verify-milestone1.mjs",
    "test:m2": "node scripts/verify-milestone2.mjs",
    "test:m3": "node scripts/verify-milestone3.mjs",
    "test:m4": "node scripts/verify-milestone4.mjs",
    "test:flow": "node scripts/verify-word-selection-flow.mjs",
    "test:join": "node scripts/verify-join-notifications.mjs",
    "test:names": "node scripts/verify-duplicate-names.mjs",
    "test:fill": "node scripts/verify-paint-bucket.mjs",
    "test:cors": "node scripts/verify-cors-split-deployment.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
