# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file or set the variables below in your deployment platform dashboards:
# - Frontend variables go to Vercel Project Settings -> Environment Variables.
# - Backend variables go to Render Web Service -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (Vercel)
# ------------------------------------------------------------------------------
# The HTTPS origin URL of your deployed Render backend (no trailing slash).
# Example: https://skribbl-clone-backend.onrender.com
# Leave blank or unset during local development to use the Vite proxy (http://localhost:5173 -> http://localhost:3000)
# or when running the unified single-port server.
VITE_BACKEND_URL=https://skribbl-clone-backend.onrender.com

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT (Render)
# ------------------------------------------------------------------------------
# Node runtime environment
NODE_ENV=production

# The port Express and Socket.IO listen on.
# Render automatically injects this variable (e.g. 10000). Defaults to 3000 locally.
PORT=3000

# Comma-separated list of exact allowed frontend origins for HTTP and Socket.IO CORS.
# Specify your production Vercel URL and any local dev origin you use.
# When unset, defaults to '*' to preserve local dev proxy and unified single-port hosting.
CLIENT_ORIGINS=https://skribbl-clone.vercel.app,http://localhost:5173
